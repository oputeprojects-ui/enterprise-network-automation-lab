*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl

# Terraform sensitive variables
terraform.tfvars
*.auto.tfvars
secrets.tfvars

# Ansible
*.retry
ansible/inventory/*/group_vars/vault.yml
ansible/inventory/*/host_vars/*/vault.yml
