configs/backups/*
!configs/backups/.gitkeep

# pyATS results
pyats/results/*
!pyats/results/.gitkeep
pyats/archive/
pyats/logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

